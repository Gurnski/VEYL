<?xml version="1.0" encoding="utf-8"?>
<!--
  Sparse package for Windows 11's main right-click menu. It holds no files of its own: the
  "external location" given when it's registered is the VEYL install folder, where
  Veyl.ShellMenu.dll and Veyl.App.exe live. build.ps1 fills in the version and publisher,
  packs this into Veyl.Menu.msix and signs it. The Publisher must match the signing
  certificate's subject exactly.
-->
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
         xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
         xmlns:desktop5="http://schemas.microsoft.com/appx/manifest/desktop/windows10/5"
         xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         IgnorableNamespaces="uap uap10 desktop4 desktop5 com rescap">
  <Identity Name="VEYL.ShellMenu" Publisher="$PUBLISHER$" Version="$VERSION$" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>VEYL right-click menu</DisplayName>
    <PublisherDisplayName>VEYL</PublisherDisplayName>
    <Logo>Assets\logo.png</Logo>
    <uap10:AllowExternalContent>true</uap10:AllowExternalContent>
  </Properties>
  <Resources>
    <Resource Language="en-us" />
  </Resources>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22000.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>
  <Applications>
    <!-- Required by the format. AppListEntry="none" keeps it out of the Start menu. -->
    <Application Id="VEYL" Executable="Veyl.App.exe" uap10:TrustLevel="mediumIL" uap10:RuntimeBehavior="win32App">
      <uap:VisualElements AppListEntry="none" DisplayName="VEYL" Description="VEYL right-click menu"
                          BackgroundColor="transparent" Square150x150Logo="Assets\logo.png" Square44x44Logo="Assets\logo.png" />
      <Extensions>
        <desktop4:Extension Category="windows.fileExplorerContextMenus">
          <desktop4:FileExplorerContextMenus>
            <desktop5:ItemType Type="*">
              <desktop5:Verb Id="VeylSandbox" Clsid="a9ebffc4-ebdc-4647-b3c2-0a8c379c3e8a" />
              <desktop5:Verb Id="VeylScan" Clsid="7934491f-812e-4cc0-89d3-bd7dd05fc79f" />
            </desktop5:ItemType>
            <desktop5:ItemType Type="Directory">
              <desktop5:Verb Id="VeylScanFolder" Clsid="7934491f-812e-4cc0-89d3-bd7dd05fc79f" />
            </desktop5:ItemType>
          </desktop4:FileExplorerContextMenus>
        </desktop4:Extension>
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:SurrogateServer DisplayName="VEYL right-click menu">
              <com:Class Id="a9ebffc4-ebdc-4647-b3c2-0a8c379c3e8a" Path="Veyl.ShellMenu.dll" ThreadingModel="STA" />
              <com:Class Id="7934491f-812e-4cc0-89d3-bd7dd05fc79f" Path="Veyl.ShellMenu.dll" ThreadingModel="STA" />
            </com:SurrogateServer>
          </com:ComServer>
        </com:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>
