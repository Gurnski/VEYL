<UserControl x:Class="Veyl.Shared.Controls.HeroBackdrop"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False">
    <!-- The launcher and setup share this backdrop: gradient, drifting glows, rising embers and the brand. -->
    <Grid ClipToBounds="True">
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0.4,1">
                    <GradientStop Color="#221829" Offset="0" />
                    <GradientStop Color="#120F17" Offset="0.75" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Ellipse x:Name="GlowAmber" Width="520" Height="360" Margin="-60,-40,0,0"
                 HorizontalAlignment="Center" VerticalAlignment="Center">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#55EBA640" Offset="0" />
                    <GradientStop Color="#00EBA640" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.RenderTransform>
                <TranslateTransform x:Name="AmberShift" />
            </Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse Width="640" Height="420" Margin="380,-260,-200,0">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#447A3FB8" Offset="0" />
                    <GradientStop Color="#007A3FB8" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.RenderTransform>
                <TranslateTransform x:Name="VioletShift" />
            </Ellipse.RenderTransform>
        </Ellipse>

        <Canvas x:Name="Embers" />

        <StackPanel x:Name="Brand" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-50,0,0">
            <Path Data="{StaticResource LogoGeometry}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.6"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                  Width="64" Height="64" Stretch="Uniform" HorizontalAlignment="Center">
                <Path.Effect>
                    <DropShadowEffect Color="#EBA640" BlurRadius="24" ShadowDepth="0" Opacity="0.8" />
                </Path.Effect>
            </Path>
            <TextBlock Text="V E Y L" FontFamily="{StaticResource UiFont}" FontSize="46" FontWeight="Bold"
                       Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" Margin="0,14,0,0">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#EBA640" BlurRadius="30" ShadowDepth="0" Opacity="0.35" />
                </TextBlock.Effect>
            </TextBlock>
            <TextBlock x:Name="TaglineText" Text="SHIELD   ·   VAULT" Style="{StaticResource Faint}" FontSize="11" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Margin="0,6,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
