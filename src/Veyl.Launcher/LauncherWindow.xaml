<Window x:Class="Veyl.Launcher.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vc="clr-namespace:Veyl.Shared.Controls;assembly=Veyl.Shared"
        Title="VEYL" Width="720" Height="420" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        Background="{StaticResource WindowBrush}" UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Grid>
        <vc:HeroBackdrop />

        <!-- Title bar -->
        <Grid VerticalAlignment="Top" Height="44" Margin="18,6,10,0">
            <Path Data="{StaticResource LogoGeometry}" Stroke="{StaticResource TextBrush}" StrokeThickness="2"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="20" Height="20" Stretch="Uniform"
                  HorizontalAlignment="Left" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Style="{StaticResource WindowButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Minimize" />
                <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Close" />
            </StackPanel>
        </Grid>

        <!-- Status -->
        <Grid VerticalAlignment="Bottom">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#00120F17" Offset="0" />
                    <GradientStop Color="#E6120F17" Offset="0.45" />
                </LinearGradientBrush>
            </Grid.Background>
            <StackPanel Margin="28,40,28,26">
                <Grid>
                    <TextBlock x:Name="StatusTitle" Text="Starting…" Style="{StaticResource H2}" FontSize="17" />
                    <TextBlock x:Name="VersionText" Style="{StaticResource Faint}" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                </Grid>
                <TextBlock x:Name="StatusDetail" Text="This may take a moment. Please don't close this window."
                           Style="{StaticResource Dim}" FontSize="12" Margin="0,3,0,12" />
                <vc:ProgressStrip x:Name="Progress" />
                <StackPanel x:Name="ErrorActions" Orientation="Horizontal" Margin="0,16,0,0" Visibility="Collapsed">
                    <Button Style="{StaticResource PrimaryButton}" Content="Retry" Click="Retry_Click" />
                    <Button Content="Exit" Margin="8,0,0,0" Click="Close_Click" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
