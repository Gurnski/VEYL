<UserControl x:Class="Veyl.App.Views.UpdateLogPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,24">
            <TextBlock Text="Update Log" Style="{StaticResource H1}" Margin="0,0,0,16" />
            <ItemsControl x:Name="Releases">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Style="{StaticResource SectionTitle}">
                                        <Run Text="v" /><Run Text="{Binding Version, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding Date}" Style="{StaticResource Label}" HorizontalAlignment="Right" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Notes}" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource Dim}" Margin="2,3,0,0" TextWrapping="Wrap">
                                                <Run Text="·" Foreground="{StaticResource TextFaintBrush}" /> <Run Text="{Binding Mode=OneWay}" />
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
