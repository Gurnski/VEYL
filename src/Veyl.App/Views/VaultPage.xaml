<UserControl x:Class="Veyl.App.Views.VaultPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <!-- ================================ first run: create vault -->
        <ScrollViewer x:Name="SetupPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <Border Style="{StaticResource Card}" Width="470" Padding="28,26" Margin="0,40" VerticalAlignment="Top">
                <StackPanel>
                    <Grid Width="56" Height="56" HorizontalAlignment="Left">
                        <Ellipse Fill="{StaticResource AccentSoftBrush}" />
                        <TextBlock Text="&#xE8D7;" Style="{StaticResource Icon}" FontSize="22" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                    </Grid>
                    <TextBlock Text="Create your vault" Style="{StaticResource H1}" Margin="0,16,0,0" />
                    <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap" TextTrimming="None" Margin="0,8,0,0">
                        Your passwords are encrypted with AES-256 using a key made from your master password, and stored in a folder only your
                        Windows account can open. Each person who signs in to this PC gets their own vault.
                    </TextBlock>

                    <TextBlock Text="Master password" Style="{StaticResource Label}" Margin="0,20,0,6" />
                    <PasswordBox x:Name="NewMaster" PasswordChanged="NewMaster_Changed" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition /><ColumnDefinition Width="4" /><ColumnDefinition /><ColumnDefinition Width="4" />
                            <ColumnDefinition /><ColumnDefinition Width="4" /><ColumnDefinition /><ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Bar1" Grid.Column="0" Height="4" CornerRadius="2" Background="{StaticResource RaisedBrush}" />
                        <Border x:Name="Bar2" Grid.Column="2" Height="4" CornerRadius="2" Background="{StaticResource RaisedBrush}" />
                        <Border x:Name="Bar3" Grid.Column="4" Height="4" CornerRadius="2" Background="{StaticResource RaisedBrush}" />
                        <Border x:Name="Bar4" Grid.Column="6" Height="4" CornerRadius="2" Background="{StaticResource RaisedBrush}" />
                        <TextBlock x:Name="StrengthText" Grid.Column="7" Style="{StaticResource Label}" Margin="10,0,0,0" MinWidth="60" />
                    </Grid>

                    <TextBlock Text="Confirm master password" Style="{StaticResource Label}" Margin="0,14,0,6" />
                    <PasswordBox x:Name="ConfirmMaster" KeyDown="Create_KeyDown" />

                    <Border Background="{StaticResource WarnSoftBrush}" CornerRadius="8" Padding="12,10" Margin="0,18,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource WarnBrush}" VerticalAlignment="Top" Margin="0,1,0,0" />
                            <TextBlock Style="{StaticResource BaseText}" Foreground="{StaticResource WarnBrush}" FontSize="12" Margin="10,0,0,0"
                                       TextWrapping="Wrap" TextTrimming="None" Width="360">
                                There is no way to recover a forgotten master password. Write it down somewhere safe.
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="SetupError" Style="{StaticResource BaseText}" Foreground="{StaticResource DangerBrush}"
                               Margin="0,12,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                    <Button x:Name="CreateButton" Style="{StaticResource PrimaryButton}" Content="Create vault" Margin="0,18,0,0"
                            HorizontalAlignment="Stretch" Padding="14,10" Click="Create_Click" />
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- ================================ locked -->
        <Border x:Name="LockedPanel" Style="{StaticResource Card}" Width="400" Padding="28,26" VerticalAlignment="Center"
                HorizontalAlignment="Center" Margin="0,0,0,60" Visibility="Collapsed">
            <StackPanel>
                <Grid Width="64" Height="64">
                    <Ellipse Fill="{StaticResource RaisedBrush}" />
                    <TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" FontSize="24" HorizontalAlignment="Center" />
                </Grid>
                <TextBlock Text="Vault locked" Style="{StaticResource H1}" HorizontalAlignment="Center" Margin="0,16,0,0" />
                <TextBlock x:Name="LockedFor" Style="{StaticResource Dim}" HorizontalAlignment="Center" Margin="0,6,0,20" />
                <PasswordBox x:Name="UnlockBox" KeyDown="Unlock_KeyDown" />
                <TextBlock x:Name="UnlockError" Style="{StaticResource BaseText}" Foreground="{StaticResource DangerBrush}"
                           Margin="0,10,0,0" Visibility="Collapsed" />
                <Button x:Name="UnlockButton" Style="{StaticResource PrimaryButton}" Content="Unlock" Margin="0,14,0,0"
                        HorizontalAlignment="Stretch" Padding="14,10" Click="Unlock_Click" />
                <Button Style="{StaticResource GhostButton}" Content="Forgot your master password?" Margin="0,10,0,0"
                        HorizontalAlignment="Center" Click="Forgot_Click" />
            </StackPanel>
        </Border>

        <!-- ================================ forgot password: recovery key -->
        <Border x:Name="RecoverPanel" Style="{StaticResource Card}" Width="440" Padding="28,26" VerticalAlignment="Center"
                HorizontalAlignment="Center" Margin="0,0,0,40" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="Reset with your recovery key" Style="{StaticResource H1}" FontSize="20" />
                <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap" TextTrimming="None" Margin="0,8,0,0">
                    Enter the recovery key VEYL gave you when you set up the vault, then choose a new master password.
                </TextBlock>
                <TextBlock Text="Recovery key" Style="{StaticResource Label}" Margin="0,18,0,6" />
                <TextBox x:Name="RecoveryBox" FontFamily="{StaticResource MonoFont}" FontSize="14" CharacterCasing="Upper"
                         Tag="XXXX-XXXX-XXXX-XXXX-XXXX-XXXX-XXXX-XXXX" />
                <TextBlock Text="New master password" Style="{StaticResource Label}" Margin="0,14,0,6" />
                <PasswordBox x:Name="ResetPw1" />
                <TextBlock Text="Confirm new master password" Style="{StaticResource Label}" Margin="0,14,0,6" />
                <PasswordBox x:Name="ResetPw2" KeyDown="Reset_KeyDown" />
                <TextBlock x:Name="RecoverError" Style="{StaticResource BaseText}" Foreground="{StaticResource DangerBrush}"
                           Margin="0,12,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                <Button x:Name="ResetButton" Style="{StaticResource PrimaryButton}" Content="Reset password" Margin="0,18,0,0"
                        HorizontalAlignment="Stretch" Padding="14,10" Click="Reset_Click" />
                <Button Style="{StaticResource GhostButton}" Content="Back" Margin="0,8,0,0" HorizontalAlignment="Center" Click="BackToLock_Click" />
            </StackPanel>
        </Border>

        <!-- ================================ unlocked -->
        <DockPanel x:Name="UnlockedPanel" Margin="24,20,24,0" Visibility="Collapsed">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Passwords" Style="{StaticResource H1}" />
                    <Border Style="{StaticResource Badge}" Margin="12,4,0,0" Background="{StaticResource RaisedBrush}">
                        <TextBlock x:Name="CountText" Style="{StaticResource BadgeText}" Foreground="{StaticResource TextDimBrush}" />
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBox x:Name="SearchBox" Width="240" Tag="Search" TextChanged="Search_Changed" />
                    <Button Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="Add_Click" AutomationProperties.Name="Add">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource OnAccentBrush}" />
                            <TextBlock Text="Add" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Margin="8,0,0,0" Click="Lock_Click" AutomationProperties.Name="Lock" ToolTip="Lock the vault now">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" FontSize="12" />
                            <TextBlock Text="Lock" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <Border x:Name="NoRecoveryBanner" DockPanel.Dock="Top" Background="{StaticResource WarnSoftBrush}" CornerRadius="10"
                    Padding="14,10" Margin="0,0,0,12" Visibility="Collapsed">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="14" Foreground="{StaticResource WarnBrush}" />
                        <TextBlock Style="{StaticResource BaseText}" Foreground="{StaticResource WarnBrush}" Margin="10,0,0,0" FontSize="12.5"
                                   Text="No recovery key yet. If you forget your master password, these passwords are gone." />
                    </StackPanel>
                    <Button Style="{StaticResource SoftAccentButton}" Content="Create recovery key" Padding="12,6"
                            HorizontalAlignment="Right" Click="CreateRecovery_Click" />
                </Grid>
            </Border>

            <Grid>
                <ListBox x:Name="EntryList" Style="{StaticResource PlainList}" VirtualizingPanel.ScrollUnit="Pixel"
                          MouseDoubleClick="EntryList_DoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="card" Style="{StaticResource Card}" Padding="12,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="38" Height="38" CornerRadius="9" Background="{Binding AvatarBrush}">
                                        <TextBlock Text="{Binding Initial}" Style="{StaticResource BaseText}" FontSize="15" FontWeight="Bold"
                                                   Foreground="#1A1308" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Entry.Title}" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Style="{StaticResource Faint}" Margin="0,2,0,0">
                                            <Run Text="{Binding Entry.Username, Mode=OneWay}" Foreground="{StaticResource TextDimBrush}" />
                                            <Run Text="{Binding UrlSuffix, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock x:Name="revealed" Text="{Binding Revealed}" FontFamily="{StaticResource MonoFont}" FontSize="13"
                                                   Foreground="{StaticResource AccentBrush}" Margin="0,5,0,0" Visibility="Collapsed" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource IconButton}" Content="&#xE77B;" ToolTip="Copy username" AutomationProperties.Name="Copy username" Click="CopyUser_Click" />
                                        <Button Style="{StaticResource IconButton}" Content="&#xE8C8;" ToolTip="Copy password" AutomationProperties.Name="Copy password" Click="CopyPassword_Click" />
                                        <Button x:Name="eye" Style="{StaticResource IconButton}" Content="&#xE890;" ToolTip="Show password" AutomationProperties.Name="Show password" Click="Reveal_Click" />
                                        <Button Style="{StaticResource IconButton}" Content="&#xE774;" ToolTip="Open website" AutomationProperties.Name="Open website" Click="Open_Click" />
                                        <Button Style="{StaticResource IconButton}" Content="&#xE70F;" ToolTip="Edit" AutomationProperties.Name="Edit" Click="Edit_Click" />
                                        <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Delete" AutomationProperties.Name="Delete" Click="Delete_Click" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsRevealed}" Value="True">
                                    <Setter TargetName="revealed" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="eye" Property="Content" Value="&#xED1A;" />
                                    <Setter TargetName="eye" Property="ToolTip" Value="Hide password" />
                                </DataTrigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="card" Property="Background" Value="{StaticResource CardHoverBrush}" />
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,60,0,0">
                    <TextBlock Text="&#xE8D7;" Style="{StaticResource Icon}" FontSize="28" Foreground="{StaticResource TextFaintBrush}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="EmptyTitle" Text="No passwords yet" Style="{StaticResource H2}" Margin="0,12,0,0" HorizontalAlignment="Center" />
                    <TextBlock x:Name="EmptyDetail" Text="Click Add to save your first one." Style="{StaticResource Faint}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>
