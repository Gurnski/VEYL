<UserControl x:Class="Veyl.App.Views.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Veyl.App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,24">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                <Border Width="54" Height="54" CornerRadius="12" Background="{StaticResource CardBrush}">
                    <Path Data="{StaticResource LogoGeometry}" Stroke="{StaticResource AccentBrush}" StrokeThickness="2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="30" Height="30" Stretch="Uniform" />
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="VEYL" Style="{StaticResource H1}" />
                    <TextBlock Text="Antivirus and password vault for your own PCs" Style="{StaticResource Dim}" />
                </StackPanel>
            </StackPanel>

            <UniformGrid Columns="2" Margin="-4,0">
                <c:StatTile x:Name="AppTile" Label="App" Margin="4" ValueBrush="{StaticResource AccentBrush}" />
                <c:StatTile x:Name="CoreTile" Label="Engine (Veyl.Core)" Margin="4" />
                <c:StatTile x:Name="InstallTile" Label="Installed in" Margin="4" />
                <c:StatTile x:Name="DataTile" Label="Data" Margin="4" />
                <c:StatTile x:Name="UserTile" Label="Windows account" Margin="4" />
                <c:StatTile x:Name="BuildTile" Label="Build" Margin="4" />
            </UniformGrid>

            <TextBlock Text="What VEYL is and isn't" Style="{StaticResource SectionTitle}" Margin="0,18,0,8" />
            <Border Style="{StaticResource Card}">
                <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap" TextTrimming="None" LineHeight="20">
                    VEYL checks files against a hash blocklist, asks Windows Defender's engine for a second opinion, and looks for
                    patterns common in malware (packed code, process injection, hidden PowerShell). It runs entirely in user mode and
                    has no kernel driver or cloud lookups, so it can't stop everything a commercial antivirus can. Keep Windows Defender
                    turned on. VEYL is an extra layer, not a replacement.
                </TextBlock>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
