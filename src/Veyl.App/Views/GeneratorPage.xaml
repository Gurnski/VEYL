<UserControl x:Class="Veyl.App.Views.GeneratorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Veyl.App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,24">
            <TextBlock Text="Generator" Style="{StaticResource H1}" Margin="0,0,0,16" />

            <Border Style="{StaticResource Card}" Padding="20,18">
                <StackPanel>
                    <TextBox x:Name="Output" IsReadOnly="True" FontFamily="{StaticResource MonoFont}" FontSize="20"
                             Background="Transparent" BorderThickness="0" Padding="0" Foreground="{StaticResource AccentBrush}" />
                    <Grid Margin="0,14,0,0">
                        <TextBlock x:Name="StrengthText" Style="{StaticResource Label}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Click="Regenerate_Click" AutomationProperties.Name="New password">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="12" />
                                    <TextBlock Text="New" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="Copy_Click" AutomationProperties.Name="Copy">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource OnAccentBrush}" />
                                    <TextBlock Text="Copy" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,8,0,8">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Length" Style="{StaticResource SectionTitle}" />
                        <TextBlock x:Name="LengthText" Style="{StaticResource SectionTitle}" HorizontalAlignment="Right"
                                   Foreground="{StaticResource AccentBrush}" />
                    </Grid>
                    <Slider x:Name="LengthSlider" Minimum="8" Maximum="64" Margin="0,10,0,0" ValueChanged="Option_Changed"
                            IsSnapToTickEnabled="True" TickFrequency="1" />
                </StackPanel>
            </Border>

            <c:SettingRow Title="Uppercase letters" Description="A-Z">
                <CheckBox x:Name="UpperToggle" Style="{StaticResource Toggle}" IsChecked="True" Click="Option_Changed" />
            </c:SettingRow>
            <c:SettingRow Title="Lowercase letters" Description="a-z">
                <CheckBox x:Name="LowerToggle" Style="{StaticResource Toggle}" IsChecked="True" Click="Option_Changed" />
            </c:SettingRow>
            <c:SettingRow Title="Numbers" Description="0-9">
                <CheckBox x:Name="DigitToggle" Style="{StaticResource Toggle}" IsChecked="True" Click="Option_Changed" />
            </c:SettingRow>
            <c:SettingRow Title="Symbols" Description="!@#$%^&amp;*()-_=+[]{};:,.?/">
                <CheckBox x:Name="SymbolToggle" Style="{StaticResource Toggle}" Click="Option_Changed" />
            </c:SettingRow>
            <c:SettingRow Title="Avoid look-alike characters" Description="Leaves out l, I, 1, O and 0 so passwords are easier to type by hand.">
                <CheckBox x:Name="AmbiguousToggle" Style="{StaticResource Toggle}" IsChecked="True" Click="Option_Changed" />
            </c:SettingRow>
            <TextBlock Style="{StaticResource Faint}" Margin="2,4,0,0" TextWrapping="Wrap">
                Length and symbols here are also used by the Generate button when you add a password.
            </TextBlock>
        </StackPanel>
    </ScrollViewer>
</UserControl>
