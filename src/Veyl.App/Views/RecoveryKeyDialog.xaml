<UserControl x:Class="Veyl.App.Views.RecoveryKeyDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource Card}" Width="560" Padding="28,24" CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.5" />
        </Border.Effect>
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Grid Width="44" Height="44">
                    <Ellipse Fill="{StaticResource AccentSoftBrush}" />
                    <TextBlock Text="&#xE8D7;" Style="{StaticResource Icon}" FontSize="18" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                </Grid>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Your recovery key" Style="{StaticResource H2}" FontSize="18" />
                    <TextBlock Text="The only way back in if you forget your master password." Style="{StaticResource Dim}" Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>

            <Border Background="{StaticResource InputBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="16,18" Margin="0,20,0,0">
                <TextBlock x:Name="KeyText" FontFamily="{StaticResource MonoFont}" FontSize="21" FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                <Button Click="Copy_Click" AutomationProperties.Name="Copy recovery key">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" FontSize="12" />
                        <TextBlock Text="Copy" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Margin="8,0,0,0" Click="Save_Click" AutomationProperties.Name="Save recovery key">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" FontSize="12" />
                        <TextBlock Text="Save as file" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <Border Background="{StaticResource WarnSoftBrush}" CornerRadius="8" Padding="12,10" Margin="0,18,0,0">
                <TextBlock Style="{StaticResource BaseText}" Foreground="{StaticResource WarnBrush}" FontSize="12"
                           TextWrapping="Wrap" TextTrimming="None">
                    Write it down or save it somewhere other than this PC, like a USB stick or printed in a drawer. Anyone with
                    this key can open your vault, and VEYL won't show it again.
                </TextBlock>
            </Border>

            <CheckBox x:Name="Confirm" Style="{StaticResource LabeledToggle}" Margin="0,18,0,0" Checked="Confirm_Changed" Unchecked="Confirm_Changed"
                      Content="I've stored my recovery key somewhere safe" />

            <Button x:Name="DoneButton" Style="{StaticResource PrimaryButton}" Content="Done" HorizontalAlignment="Stretch"
                    Padding="14,10" Margin="0,16,0,0" IsEnabled="False" Click="Done_Click" />
        </StackPanel>
    </Border>
</UserControl>
