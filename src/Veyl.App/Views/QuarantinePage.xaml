<UserControl x:Class="Veyl.App.Views.QuarantinePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="24,20,24,0">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="Quarantine" Style="{StaticResource H1}" />
            <TextBlock Style="{StaticResource Dim}" Margin="0,6,0,0" TextWrapping="Wrap" TextTrimming="None">
                Quarantined files are scrambled so they can't run, and kept in C:\ProgramData\VEYL\quarantine until you restore or delete them.
            </TextBlock>
        </StackPanel>

        <Grid>
            <ListBox x:Name="Items" Style="{StaticResource PlainList}" VirtualizingPanel.ScrollUnit="Pixel">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource RaisedBrush}">
                                    <TextBlock Text="&#xE7B8;" Style="{StaticResource Icon}" HorizontalAlignment="Center"
                                               Foreground="{StaticResource TextDimBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="{Binding Item.OriginalPath}" Style="{StaticResource Faint}" Margin="0,2,0,0" />
                                    <TextBlock Style="{StaticResource Label}" Margin="0,4,0,0">
                                        <Run Text="{Binding Item.Threat, Mode=OneWay}" Foreground="{StaticResource WarnBrush}" />
                                        <Run Text="  ·  " /><Run Text="{Binding When, Mode=OneWay}" />
                                        <Run Text="  ·  " /><Run Text="{Binding Size, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Restore" Padding="12,6" Click="Restore_Click" />
                                    <Button Style="{StaticResource DangerButton}" Content="Delete" Padding="12,6" Margin="6,0,0,0" Click="Delete_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel x:Name="Empty" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,50,0,0">
                <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="28" Foreground="{StaticResource GoodBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="Nothing in quarantine" Style="{StaticResource H2}" Margin="0,12,0,0" HorizontalAlignment="Center" />
                <TextBlock Text="Files VEYL isolates will appear here." Style="{StaticResource Faint}" HorizontalAlignment="Center" Margin="0,4,0,0" />
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>
