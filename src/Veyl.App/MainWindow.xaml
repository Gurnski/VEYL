<Window x:Class="Veyl.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VEYL" Width="1180" Height="760" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        Background="{StaticResource WindowBrush}" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="56" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================================== top bar -->
        <Grid Grid.Row="0" Margin="12,0,8,0">
            <Button x:Name="WorkspaceButton" HorizontalAlignment="Left" VerticalAlignment="Center"
                    WindowChrome.IsHitTestVisibleInChrome="True" Click="WorkspaceButton_Click" Padding="12,7"
                    Background="{StaticResource CardBrush}">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource LogoGeometry}" Stroke="{StaticResource AccentBrush}" StrokeThickness="2.2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center" />
                    <TextBlock Text="VEYL" FontFamily="{StaticResource UiFont}" FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}" Margin="9,0,0,1" VerticalAlignment="Center" />
                    <TextBlock x:Name="WorkspaceChevron" Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="10"
                               Foreground="{StaticResource TextDimBrush}" Margin="10,2,0,0" RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <RotateTransform x:Name="ChevronRotate" />
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </StackPanel>
            </Button>

            <!-- Workspace switcher -->
            <Popup x:Name="WorkspacePopup" PlacementTarget="{Binding ElementName=WorkspaceButton}" Placement="Bottom"
                   VerticalOffset="6" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
                   Closed="WorkspacePopup_Closed">
                <Border Background="{StaticResource CardBrush}" CornerRadius="10" Padding="6" Width="250"
                        BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Margin="0,0,12,12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.5" />
                    </Border.Effect>
                    <ItemsControl x:Name="WorkspaceList" />
                </Border>
            </Popup>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="ShieldChip" Style="{StaticResource GhostButton}" Click="ShieldChip_Click"
                        WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Protection status">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="ShieldIcon" Text="&#xEA18;" Style="{StaticResource Icon}" FontSize="14" />
                        <TextBlock x:Name="ShieldText" Style="{StaticResource BaseText}" FontWeight="SemiBold" Margin="7,0,0,0" />
                    </StackPanel>
                </Button>
                <Button x:Name="VaultChip" Style="{StaticResource GhostButton}" Click="VaultChip_Click" Margin="4,0,0,0"
                        WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Vault">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="VaultIcon" Style="{StaticResource Icon}" FontSize="14" />
                        <TextBlock x:Name="VaultText" Style="{StaticResource BaseText}" FontWeight="SemiBold" Margin="7,0,0,0" />
                    </StackPanel>
                </Button>
                <StackPanel Orientation="Horizontal" Margin="12,0,14,0" VerticalAlignment="Center">
                    <Border Width="26" Height="26" CornerRadius="13" Background="{StaticResource RaisedBrush}">
                        <TextBlock x:Name="AvatarText" Style="{StaticResource BaseText}" FontSize="11.5" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="UserText" Style="{StaticResource BaseText}" FontWeight="SemiBold" Margin="8,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
                <Button Style="{StaticResource WindowButton}" Content="&#xE921;" Click="Minimize_Click" />
                <Button x:Name="MaxButton" Style="{StaticResource WindowButton}" Content="&#xE922;" Click="Maximize_Click" />
                <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="Close_Click" />
            </StackPanel>
        </Grid>

        <!-- ============================================== body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="232" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <DockPanel Grid.Column="0" Margin="14,12,14,0" ClipToBounds="True">
                <Grid DockPanel.Dock="Top" Margin="6,0,0,18">
                    <StackPanel x:Name="SidebarHeader" HorizontalAlignment="Left">
                        <TextBlock x:Name="WorkspaceTitle" Style="{StaticResource H1}" FontSize="23" />
                        <Border Height="2" Background="{StaticResource AccentBrush}" CornerRadius="1" Margin="0,5,0,0"
                                Width="{Binding ActualWidth, ElementName=WorkspaceTitle}" HorizontalAlignment="Left" Opacity="0.8" />
                    </StackPanel>
                    <Button x:Name="CollapseButton" Style="{StaticResource IconButton}" Content="&#xE76B;" FontSize="11"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Click="Collapse_Click" ToolTip="Collapse sidebar" />
                </Grid>

                <StackPanel DockPanel.Dock="Top">
                    <StackPanel x:Name="NavPanel" />
                    <Border Height="1" Background="{StaticResource DividerBrush}" Margin="8,14,8,14" />
                    <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Padding="12,7"
                            Click="OpenDefender_Click" HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE83D;" Style="{StaticResource Icon}" Width="22" Foreground="{StaticResource TextDimBrush}" />
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock Text="Windows Security" Style="{StaticResource BaseText}" FontWeight="SemiBold" />
                                <TextBlock Text="Defender stays on" Style="{StaticResource Faint}" />
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Padding="12,7" Margin="0,2,0,0"
                            Click="OpenData_Click" HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" Width="22" Foreground="{StaticResource TextDimBrush}" />
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock Text="Data folder" Style="{StaticResource BaseText}" FontWeight="SemiBold" />
                                <TextBlock Text="C:\ProgramData\VEYL" Style="{StaticResource Faint}" />
                            </StackPanel>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Decorative footer -->
                <Grid x:Name="SidebarArt" VerticalAlignment="Bottom" Margin="0,0,0,18" Height="110">
                    <Path Data="M50,4 L92,18 L92,52 C92,78 74,96 50,106 C26,96 8,78 8,52 L8,18 Z" Stroke="{StaticResource CardBorderBrush}"
                          StrokeThickness="2" Width="84" Height="96" Stretch="Uniform" HorizontalAlignment="Center" />
                    <Path Data="{StaticResource LogoGeometry}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="34" Height="34" Stretch="Uniform"
                          HorizontalAlignment="Center" Margin="0,0,0,8" Opacity="0.7" />
                    <Border Height="1" Background="{StaticResource DividerBrush}" VerticalAlignment="Bottom" Margin="20,0" />
                </Grid>
            </DockPanel>

            <Border Grid.Column="1" Background="{StaticResource DividerBrush}" />

            <!-- Page host -->
            <ContentControl x:Name="PageHost" Grid.Column="2" Focusable="False" RenderTransformOrigin="0.5,0.5">
                <ContentControl.RenderTransform>
                    <TranslateTransform x:Name="PageShift" />
                </ContentControl.RenderTransform>
            </ContentControl>
        </Grid>

        <!-- ============================================== overlay (dialogs) -->
        <Grid x:Name="Overlay" Grid.RowSpan="2" Visibility="Collapsed" Background="#B30A080D">
            <ContentControl x:Name="OverlayHost" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>

        <!-- ============================================== toast -->
        <Border x:Name="Toast" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24"
                Background="{StaticResource RaisedBrush}" CornerRadius="8" Padding="14,10" Opacity="0" IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.45" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource GoodBrush}" />
                <TextBlock x:Name="ToastText" Style="{StaticResource BaseText}" Margin="9,0,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
