<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <!-- Only for the tray NotifyIcon. -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Veyl.App</AssemblyName>
    <RootNamespace>Veyl.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <!-- WinForms and WPF both define these; prefer the WPF ones. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Veyl.Shared\Veyl.Shared.csproj" />
  </ItemGroup>
</Project>
